// The public demo at https://demo.9artifacts.com: the same Worker with DEMO=1,
// so visitors browse read-only and only the owner publishes.
// Deploy with `npm run deploy:demo` (needs the 9artifacts.com zone on the account).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "9artifacts-demo",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "demo.9artifacts.com", "custom_domain": true }],
  "assets": {
    "directory": "../dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "9artifacts-demo", "migrations_dir": "../migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "9artifacts-demo-files" }
  ],
  "vars": {
    "NAME": "9artifacts",
    "PUBLIC_URL": "https://demo.9artifacts.com",
    "CONTENT_URL": "https://demo-content.9artifacts.com",
    "MAX_UPLOAD_MB": "50",
    "SHARES_ON_CONTENT": "",
    "ARTIFACT_CSP": "",
    "DEMO": "1",
    "VERSION": "cf-0.1.0"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
