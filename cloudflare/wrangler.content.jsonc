// 9artifacts-content: the separate, sandboxed origin for artifact bytes
// (9artifacts-content.<subdomain>.workers.dev). It owns no data: every request
// is handed to the 9artifacts Worker over a service binding, and that Worker
// serves only /c/... and /s/.../f|g/... on this host (everything else is 404).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "9artifacts-content",
  "main": "src/content-proxy.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "APP", "service": "9artifacts" }],
  "observability": { "enabled": false }
}
